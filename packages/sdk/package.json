{
  "name": "@ouicu/sdk",
  "version": "0.1.2",
  "description": "Share a port on your computer at a public link, or put a built site up, from Node.",
  "keywords": [
    "ouicu",
    "localhost",
    "tunnel",
    "share-localhost",
    "ngrok-alternative",
    "preview",
    "share",
    "deploy",
    "static site"
  ],
  "homepage": "https://ouicu.com/docs/sdk",
  "bugs": {
    "email": "hello@ouicu.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroqdotdev/ouicu-js.git",
    "directory": "packages/sdk"
  },
  "author": {
    "name": "Mads Sauer",
    "url": "https://ouicu.com/about"
  },
  "engines": {
    "node": ">=20.3"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
