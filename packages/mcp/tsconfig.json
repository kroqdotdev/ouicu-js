{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // The SDK's source, so this checks and tests before the SDK is built.
    "paths": { "@ouicu/sdk": ["../sdk/src/index.ts"] }
  },
  "include": ["src/**/*", "bin/**/*", "*.config.ts", "*.config.mts"],
  "exclude": ["node_modules", "dist"]
}
